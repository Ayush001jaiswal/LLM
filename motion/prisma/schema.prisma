// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int                   @id @default(autoincrement())
  email         String                @unique
  passwordHash  String
  createdAt     DateTime              @default(now())
  conversations Conversation[]
  resumes       Resume[]
  mcpServers    McpServerConnection[]
}

model Conversation {
  id        Int       @id @default(autoincrement())
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents Document[]

  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  role           String       // "user" or "assistant"
  content        String
  quote          String?
  sources        Json?
  createdAt      DateTime     @default(now())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Document {
  id             Int             @id @default(autoincrement())
  filename       String
  createdAt      DateTime        @default(now())
  conversationId Int
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([conversationId])
}

model DocumentChunk {
  id             Int      @id @default(autoincrement())
  position       Int
  content        String
  embedding      Float[]
  documentId     Int
  conversationId Int
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Resume {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String
  format         String
  targetRole     String
  jobDescription String?
  instructions   String?
  status         String   @default("queued")
  progress       String   @default("")
  error          String?
  original       Json?
  improved       Json?
  review         Json?
  report         Json?
  notes          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([userId])
}

model KnowledgeChunk {
  id        Int     @id @default(autoincrement())
  source    String
  topic     String
  content   String
  embedding Float[]

  @@index([source])
}

model McpServerConnection {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  serverType   String    @default("custom") // "slack", "gmail", "github", "custom"
  url          String
  headers      Json?
  enabled      Boolean   @default(true)
  tools        Json?
  lastTestedAt DateTime?
  status       String    @default("connected") // "connected", "error", "pending"
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([userId])
}

