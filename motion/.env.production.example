# ==============================================================================
# MOTION BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION (Render / Cloud)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (Neon Serverless PostgreSQL - Free Tier)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
# Generate a strong random 32+ char secret:
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# Frontend Origin for CORS (e.g. your Vercel URL)
FRONTEND_ORIGIN=https://YOUR_MOTION_APP.vercel.app

# Google Gemini API ($0 Free Tier - handles Chat, JSON parsing, ATS scoring & Job Matching)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
EMBED_PROVIDER=gemini

# Adzuna Job Search API ($0 Free Tier)
ADZUNA_APP_ID=a1a3d61a
ADZUNA_APP_KEY=1deea638a48dc0a0f6ec8ab44f28ad24
ADZUNA_COUNTRY=in
